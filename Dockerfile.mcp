# Dockerfile for kube-watcher MCP server
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY mcp/ ./mcp/
COPY pkg/ ./pkg/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /kube-watcher-mcp ./mcp/cmd/server

# Final minimal image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates \
    && addgroup -S nonroot -g 65532 \
    && adduser -S nonroot -G nonroot -u 65532 -h /home/nonroot

USER nonroot:nonroot
WORKDIR /home/nonroot

COPY --from=builder --chown=nonroot:nonroot /kube-watcher-mcp /usr/local/bin/kube-watcher-mcp

# Create directory for BadgerDB
RUN mkdir -p /home/nonroot/.kube-watcher && chown -R nonroot:nonroot /home/nonroot/.kube-watcher

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/kube-watcher-mcp"]
CMD ["--http-addr", ":8080"]