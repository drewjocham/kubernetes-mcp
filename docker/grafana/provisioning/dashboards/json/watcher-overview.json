{
  "id": null,
  "uid": "watcher-overview",
  "title": "Watcher Golden Signals",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "tags": ["watcher", "golden-signal"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Pod Restart Count",
      "targets": [
        {
          "expr": "sum by (namespace, pod) (kube_watcher_pod_restart_count)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "lineWidth": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "CPU Limit Gap (mCPU)",
      "targets": [
        {
          "expr": "sum by (namespace, pod) (kube_watcher_pod_cpu_limit_gap_milli)",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mc",
          "lineWidth": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9}
    }
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  }
}
