ARG BUILD_IMAGE=golang:1.25.7-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim

ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

FROM --platform=$BUILDPLATFORM ${BUILD_IMAGE} AS builder

ARG VERSION
ARG GIT_COMMIT
ARG BUILD_DATE

ENV CGO_ENABLED=1
WORKDIR /src

COPY go.mod go.sum ./

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
WORKDIR /src

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -ldflags="-s -w -X main.version=${VERSION} -X main.gitCommit=${GIT_COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o /out/app ./cmd/processor

FROM --platform=$TARGETPLATFORM ${RUNTIME_IMAGE} AS final
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/app /app/processor
USER nobody:nogroup
ENTRYPOINT ["/app/processor"]