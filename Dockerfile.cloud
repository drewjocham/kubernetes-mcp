# Dockerfile for kube-watcher cloud service
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY cloud/ ./cloud/
COPY pkg/ ./pkg/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /kube-watcher-cloud ./cloud/cmd/server

# Final minimal image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates \
    && addgroup -S nonroot -g 65532 \
    && adduser -S nonroot -G nonroot -u 65532 -h /home/nonroot

USER nonroot:nonroot
WORKDIR /home/nonroot

COPY --from=builder --chown=nonroot:nonroot /kube-watcher-cloud /usr/local/bin/kube-watcher-cloud

# Create directory for database
RUN mkdir -p /home/nonroot/.kube-watcher/cloud && chown -R nonroot:nonroot /home/nonroot/.kube-watcher

EXPOSE 9090

ENV CLOUD_DB_PATH=/home/nonroot/.kube-watcher/cloud/cloud.db
ENV CLOUD_HTTP_ADDR=:9090
ENV CLOUD_JWT_SECRET=changeme-in-production

ENTRYPOINT ["/usr/local/bin/kube-watcher-cloud"]
CMD ["--http-addr", ":9090"]