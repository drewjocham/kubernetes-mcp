# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.

.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
# Editor files
*.sublime-*
# Kubernetes files
*.kubeconfig
# Helm files
charts/
*.tgz
*.tar.gz
# Test files
tests/
test/
*.test.yaml
# Development files
.devcontainer/
.docker/
.env
.env.*
# Documentation
*.md
!README.md
# CI/CD
.github/
.gitlab-ci.yml
.circleci/
.travis.yml
# Logs
*.log
# Temporary directories
tmp/
temp/