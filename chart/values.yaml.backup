namespaces:
  kubeWatcher: kube-watcher
  anomstack: kw-anomaly

serviceAccount:
  name: kube-watcher
  create: true

# ─── MCP Server ─────────────────────────────────────────────────────────────
mcp:
  enabled: true
  image:
    repository: watcher-mcp
    tag: latest
    pullPolicy: IfNotPresent
  port: 8080
  logLevel: info
  # BadgerDB history path inside the container
  dbPath: /home/nonroot/.kube-watcher/history.db
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi

# ─── Watcher Event Engine (+ Badger Explorer sidecar) ───────────────────────
watcher:
  enabled: false
  image:
    repository: watcher
    tag: latest
    pullPolicy: IfNotPresent
  ports:
    http: 8085
    metrics: 9095
  logLevel: info
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi
  # Set enabled: true to use a PVC instead of emptyDir for the BadgerDB data.
  # ReadWriteOnce is sufficient for single-node clusters (minikube / kind).
  persistence:
    enabled: false
    size: 1Gi
    storageClass: ""

badgerExplorer:
  enabled: true
  image:
    repository: watcher-badger-explorer
    tag: latest
    pullPolicy: IfNotPresent
  port: 4101
  historyLimit: 120

# ─── Prometheus ─────────────────────────────────────────────────────────────
prometheus:
  enabled: true
  image:
    repository: prom/prometheus
    tag: latest
    pullPolicy: IfNotPresent
  port: 9090
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi

# ─── Grafana ─────────────────────────────────────────────────────────────────
grafana:
  enabled: true
  image:
    repository: grafana/grafana-oss
    tag: latest
    pullPolicy: IfNotPresent
  port: 3000
  adminUser: admin
  adminPassword: admin
  plugins: "grafana-piechart-panel"
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi
  persistence:
    enabled: false
    size: 1Gi
    storageClass: ""

# ─── Anomstack (Dagster-based anomaly detection)
anomstack:
  enabled: false
  dagster:
    image:
      repository: anomstack_dagster_image
      tag: kw-local
      pullPolicy: IfNotPresent
  dashboard:
    image:
      repository: anomstack_dashboard_image
      tag: kw-local
      pullPolicy: IfNotPresent
  env:
    duckdbPath: /data/anomstack.db
    home: /opt/dagster/app
    tableKey: tmp.metrics
    dashboardPort: "8080"
    llmPlatform: openai
    llmalertModels: gpt-4o-mini
  persistence:
    size: 5Gi
    storageClass: ""
  resources:
    daemon:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
    webserver:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
    dashboard:
      requests:
        cpu: 50m
        memory: 128Mi
      limits:
        cpu: 200m
        memory: 256Mi

# ─── K8sGPT (AI-Powered Kubernetes Analysis) ────────────────────────────────
k8sgpt:
  enabled: false
  image:
    repository: k8sgpt/k8sgpt
    tag: latest
    pullPolicy: IfNotPresent
  port: 8089
  mcpPort: 8089
  # K8sGPT backend configuration
  backend: openai
  model: gpt-4o
  # API key for AI provider (set via environment variable or secret)
  apiKey: ""
  # Enable MCP server for AI assistant integration
  enableMCP: true
  resources:
    requests:
      cpu: 100m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 256Mi

# ─── Signoz (Observability Platform) ────────────────────────────────────────
signoz:
  enabled: true
  replicaCount: 1
  image:
    repository: signoz/signoz
    tag: v0.117.1
    pullPolicy: IfNotPresent
  clickhouse:
    image:
      repository: clickhouse/clickhouse-server
      tag: 23.8-alpine
      pullPolicy: IfNotPresent
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi
  otelCollector:
    enabled: true
    replicaCount: 1
    image:
      repository: otel/opentelemetry-collector
      tag: 0.102.1
      pullPolicy: IfNotPresent
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 256Mi
  ingress:
    enabled: true
    host: signoz.local
    path: /
    annotations:
      nginx.ingress.kubernetes.io/rewrite-target: /
    tls: []
