{{- if .Values.anomstack.enabled }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anomstack-dagster
  namespace: {{ .Values.namespaces.anomstack }}
  labels:
    app: anomstack
    component: dagster
    {{- include "kube-watcher.labels" . | nindent 4 }}
spec:
  replicas: {{ .Values.anomstack.replicaCount }}
  selector:
    matchLabels:
      app: anomstack
      component: dagster
  template:
    metadata:
      labels:
        app: anomstack
        component: dagster
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/metrics"
    spec:
      {{- if .Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml .Values.imagePullSecrets | nindent 8 }}
      {{- end }}
      containers:
        - name: dagster
           image: {{ .Values.anomstack.dagster.image.repository }}:{{ .Values.anomstack.dagster.image.tag }}
           imagePullPolicy: {{ .Values.anomstack.dagster.image.pullPolicy }}
           ports:
             - containerPort: 3000
               name: http
          envFrom:
            - configMapRef:
                name: anomstack-env
          volumeMounts:
            - name: data
              mountPath: /data
            - name: dagster-storage
              mountPath: /opt/dagster/dagster_home/storage
            - name: metrics
              mountPath: /opt/dagster/app/metrics/system_metrics
            - name: workspace
              mountPath: /opt/dagster/dagster_home/workspace.yaml
              subPath: workspace.yaml
          resources:
            {{- toYaml .Values.anomstack.resources.webserver | nindent 12 }}
          livenessProbe:
            httpGet:
              path: /server/health
              port: 3000
            initialDelaySeconds: 60
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /server/health
              port: 3000
            initialDelaySeconds: 30
            periodSeconds: 5
            timeoutSeconds: 10
            failureThreshold: 3
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: anomstack-data
        - name: dagster-storage
          persistentVolumeClaim:
            claimName: anomstack-dagster-storage
        - name: metrics
          configMap:
            name: anomstack-system-metrics
        - name: workspace
          configMap:
            name: anomstack-workspace
{{- end }}