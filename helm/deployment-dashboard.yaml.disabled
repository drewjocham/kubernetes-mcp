{{- if .Values.anomstack.enabled }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anomstack-dashboard
  namespace: {{ .Values.namespaces.anomstack }}
  labels:
    app: anomstack
    component: dashboard
    {{- include "kube-watcher.labels" . | nindent 4 }}
spec:
  replicas: {{ .Values.anomstack.replicaCount }}
  selector:
    matchLabels:
      app: anomstack
      component: dashboard
  template:
    metadata:
      labels:
        app: anomstack
        component: dashboard
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "8080"
        prometheus.io/path: "/metrics"
    spec:
      {{- if .Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml .Values.imagePullSecrets | nindent 8 }}
      {{- end }}
      {{- with .Values.anomstack.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.anomstack.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.anomstack.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
       containers:
         - name: dashboard
           image: {{ .Values.anomstack.dashboard.image.repository }}:{{ .Values.anomstack.dashboard.image.tag }}
           imagePullPolicy: {{ .Values.anomstack.dashboard.image.pullPolicy }}
           command:
             - uvicorn
             - dashboard.app:app
             - --host
             - 0.0.0.0
             - --port
             - "8080"
           ports:
             - containerPort: 8080
               name: http
            env:
              - name: ANOMSTACK_DUCKDB_PATH
                value: {{ .Values.anomstack.env.duckdbPath | quote }}
              - name: ANOMSTACK_HOME
                value: {{ .Values.anomstack.env.home | quote }}
              - name: ANOMSTACK_TABLE_KEY
                value: {{ .Values.anomstack.env.tableKey | quote }}
              - name: ANOMSTACK_DASHBOARD_PORT
                value: {{ .Values.anomstack.env.dashboardPort | quote }}
              - name: ANOMSTACK_LLM_PLATFORM
                value: {{ .Values.anomstack.env.llmPlatform | quote }}
              - name: ANOMSTACK_LLMALERT_MODELS
                value: {{ .Values.anomstack.env.llmalertModels | quote }}
              - name: GOOGLE_CLOUD_PROJECT
                value: {{ .Values.anomstack.env.googleCloudProject | quote }}
              - name: ANOMSTACK_PUBSUB_TOPIC
                value: {{ .Values.anomstack.env.anomstackPubsubTopic | quote }}
            envFrom:
             - configMapRef:
                 name: anomstack-env
           volumeMounts:
             - name: data
               mountPath: /data
           resources:
             {{- toYaml .Values.anomstack.resources.dashboard | nindent 12 }}
           livenessProbe:
             httpGet:
               path: /health
               port: 8080
             initialDelaySeconds: 60
             periodSeconds: 10
             timeoutSeconds: 10
             failureThreshold: 3
           readinessProbe:
             httpGet:
               path: /health
               port: 8080
             initialDelaySeconds: 30
             periodSeconds: 5
             timeoutSeconds: 10
             failureThreshold: 3
       volumes:
         - name: data
           persistentVolumeClaim:
             claimName: anomstack-data
{{- end }}