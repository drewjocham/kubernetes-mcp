# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
build/
dist/
.continue

# External tool directories (large, do not commit)
anomstack/
popeye/

*/node_modules/**
# Test binary, built with `go test -c`
*.test

event-engine-badger/
event-engine-badger/*.vlog
event-engine-badger/*.mem

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.html

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log

# Temporary files
tmp/
temp/
.tmp/

# Environment variables
.env
.env.local
.env.*.local

# Kubernetes config (be careful not to commit sensitive kubeconfig)
kubeconfig
*.kubeconfig

# Local configuration files
config.local.json
config.local.yaml
config.local.yml

# Debug files
debug
debug.test
__debug_bin

# Air live reload tool
.air.toml
tmp/

# Test cache
.cache/

# Profiling data
cpu.prof
mem.prof
profile.cov

# Nuxt generated output (do not commit)
dashboard/.nuxt/
dashboard/.output/
